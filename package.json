{
  "name": "herdr-obsidian",
  "version": "0.1.0",
  "description": "Herdr AI coding agents inside Obsidian: embedded terminal tabs, live status, and file drag-and-drop.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "herdr",
    "ai",
    "coding-agents"
  ],
  "author": "XicuM",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XicuM/herdr-obsidian.git"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "^0.28.2",
    "obsidian": "latest",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
